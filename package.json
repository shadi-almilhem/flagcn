{
  "name": "flagcn",
  "private": true,
  "version": "0.1.0",
  "description": "Accessible, source-owned flag components for the shadcn CLI.",
  "license": "MIT",
  "author": "Shadi Al Milhem",
  "homepage": "https://flagcn.pages.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/shadi-almilhem/flagcn.git"
  },
  "bugs": {
    "url": "https://github.com/shadi-almilhem/flagcn/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "shadcn",
    "registry",
    "flags",
    "react",
    "typescript",
    "accessibility"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-registry.mjs && shadcn build && tsc -b && vite build",
    "build:site": "tsc -b && vite build",
    "preview:cloudflare": "pnpm dlx wrangler@latest pages dev dist",
    "deploy:cloudflare": "pnpm dlx wrangler@latest pages deploy dist --project-name flagcn",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:install": "node scripts/test-registry-install.mjs",
    "test:watch": "vitest",
    "registry:generate": "node scripts/generate-registry.mjs",
    "registry:build": "node scripts/generate-registry.mjs && shadcn build",
    "registry:check": "node scripts/check-registry.mjs",
    "check": "eslint . && vitest run && node scripts/generate-registry.mjs && shadcn build && node scripts/check-registry.mjs && node scripts/test-registry-install.mjs && tsc -b"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@tabler/icons-react": "^3.34.1",
    "@tailwindcss/vite": "^4.1.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.12.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "shadcn": "^4.18.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.50.1",
    "vite": "^7.3.0",
    "vitest": "^4.0.16"
  },
  "packageManager": "pnpm@11.19.0"
}
