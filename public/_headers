/*
  Content-Security-Policy: default-src 'self'; img-src 'self' https://flagcdn.com https://cdn.jsdelivr.net blob: data:; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' https://flagcdn.com https://cdn.jsdelivr.net; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

/r/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Cache-Control: public, max-age=0, must-revalidate

/llms.txt
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/llms-full.txt
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/AGENTS.md
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600
  Content-Type: text/markdown; charset=utf-8

/assets/*
  Cache-Control: public, max-age=31536000, immutable

https://:version.flagcn.pages.dev/*
  X-Robots-Tag: noindex
